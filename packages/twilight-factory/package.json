{
  "name": "twilightfactory-cli",
  "version": "0.0.1",
  "description": "Per-repo daemon and a Pi extension: watch the default branch, run actions, start local agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tf": "dist/cli.js",
    "twilightfactory": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "wireit",
    "lint": "wireit",
    "typecheck": "wireit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@hono/node-server": "^2.1.11",
    "@octokit/auth-oauth-device": "^8.0.5",
    "commander": "^15.1.0",
    "dirsql": "^0.4.183",
    "eventsource-parser": "^4.1.3",
    "hono": "^4.13.19",
    "pi-claude-bridge": "0.13.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.9.1",
    "twilight-gh": "link:../gh",
    "twilight-state-machine": "link:../state-machine",
    "typebox": "1.3.27",
    "undici": "^8.13.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "typescript": "^5.9.3",
    "wireit": "^0.15.0"
  },
  "repository": "https://github.com/thekevinscott/twilightfactory",
  "files": [
    "dist/"
  ],
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.json",
      "dependencies": [
        "../gh:build",
        "../state-machine:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint": {
      "command": "eslint src",
      "dependencies": [
        "../gh:build",
        "../state-machine:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "eslint.config.js"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json --noEmit",
      "dependencies": [
        "../gh:build",
        "../state-machine:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  }
}
